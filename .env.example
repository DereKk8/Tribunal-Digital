# Tribunal Digital — configuración de ejemplo (SIN secretos).
# Copie este archivo como .env (o ejecute `npm run configurar`) y complete los valores.
# El archivo .env está ignorado por Git: nunca lo suba al repositorio.

# Modo de contenido (obligatorio): demo | real
#   demo → usa SOLO fixtures/demo/ (datos ficticios de prueba)
#   real → usa SOLO el paquete de Agente A (content/, projection/, assets/) y la clave privada real
CONTENT_MODE=demo

# Contraseña del panel de moderación (obligatoria, mínimo 10 caracteres).
# `npm run configurar` genera una aleatoria.
MODERATOR_PASSWORD=

# Ruta de la clave privada real (solo modo real). Debe estar fuera de Git.
ANSWER_KEY_PATH=content/answer-key.private.json

# Red: 0.0.0.0 permite que los teléfonos de la misma Wi-Fi se conecten.
HOST=0.0.0.0
PORT=3000

# Carpeta local (ignorada por Git) para la base de datos SQLite.
DATA_DIR=data

# Intentos fallidos de inicio de sesión permitidos por dirección IP cada 5 minutos.
LOGIN_MAX_FAILURES=10

# Tope global de intentos fallidos (todas las IP juntas) cada 5 minutos.
LOGIN_GLOBAL_MAX_FAILURES=200

# Solo en alojamiento detrás de un proxy HTTPS (p. ej. Render): 1 = confiar en X-Forwarded-For/Proto
# (cookies Secure y límite de intentos por IP real). En el portátil con Wi-Fi local, déjelo vacío.
TRUST_PROXY=
