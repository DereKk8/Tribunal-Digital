{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tribunal-digital.local/schema/1.0/demo",
  "title": "Tribunal Digital — esquema provisional v1.0 (DEMO)",
  "description": "Esquema PROVISIONAL de la aplicación para schema_version 1.0. La raíz valida content/public.json; $defs.answer_key valida la clave privada y $defs.projection_map el mapa de proyección. Las comprobaciones entre archivos (referencias, revelado, recursos) se hacen en código (src/content/validate.js). El esquema canónico es el de Agente A (content/schema.json).",
  "$ref": "#/$defs/public_case",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "spanish_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "round_id": {
      "enum": ["R1", "R2", "R3", "R4", "FINAL"]
    },
    "team_id": {
      "enum": ["azul", "rojo", "verde", "amarillo", "morado"]
    },
    "objection_kind": {
      "enum": ["contradiction", "logical_leap", "unjustified_certainty", "unsafe_action"]
    },
    "evidence_set": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "public_case": {
      "type": "object",
      "required": ["schema_version", "game_id", "teams", "rounds"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "game_id": {"const": "tribunal-digital"},
        "title": {"$ref": "#/$defs/spanish_text"},
        "teams": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": {"$ref": "#/$defs/team_id"},
              "name": {"$ref": "#/$defs/spanish_text"}
            }
          }
        },
        "rounds": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {"$ref": "#/$defs/round", "properties": {"id": {"const": "R1"}}},
            {"$ref": "#/$defs/round", "properties": {"id": {"const": "R2"}}},
            {"$ref": "#/$defs/round", "properties": {"id": {"const": "R3"}}},
            {"$ref": "#/$defs/round", "properties": {"id": {"const": "R4"}}},
            {"$ref": "#/$defs/round", "properties": {"id": {"const": "FINAL"}}}
          ],
          "items": false
        }
      },
      "not": {
        "anyOf": [
          {"required": ["accepted_arguments"]},
          {"required": ["accepted_actions"]},
          {"required": ["accepted_objections"]}
        ]
      }
    },
    "round": {
      "type": "object",
      "required": ["id", "title", "evidence", "claims", "actions"],
      "properties": {
        "id": {"$ref": "#/$defs/round_id"},
        "title": {"$ref": "#/$defs/spanish_text"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "body", "asset_path", "revealed_in"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "body": {"$ref": "#/$defs/spanish_text"},
              "asset_path": {"type": "string", "pattern": "^assets/[A-Za-z0-9_./-]+$"},
              "revealed_in": {"$ref": "#/$defs/round_id"}
            }
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "text": {"$ref": "#/$defs/spanish_text"}
            }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "text": {"$ref": "#/$defs/spanish_text"}
            }
          }
        }
      },
      "not": {
        "anyOf": [
          {"required": ["accepted_arguments"]},
          {"required": ["accepted_actions"]},
          {"required": ["accepted_objections"]}
        ]
      }
    },
    "answer_key": {
      "type": "object",
      "required": ["schema_version", "game_id", "rounds"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "game_id": {"const": "tribunal-digital"},
        "rounds": {
          "type": "object",
          "required": ["R1", "R2", "R3", "R4", "FINAL"],
          "additionalProperties": false,
          "properties": {
            "R1": {"$ref": "#/$defs/round_key"},
            "R2": {"$ref": "#/$defs/round_key"},
            "R3": {"$ref": "#/$defs/round_key"},
            "R4": {"$ref": "#/$defs/round_key"},
            "FINAL": {"$ref": "#/$defs/round_key"}
          }
        }
      }
    },
    "round_key": {
      "type": "object",
      "required": ["accepted_arguments", "accepted_actions", "accepted_objections"],
      "properties": {
        "accepted_arguments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["claim_id", "evidence_ids"],
            "properties": {
              "claim_id": {"$ref": "#/$defs/id"},
              "evidence_ids": {"$ref": "#/$defs/evidence_set"}
            }
          }
        },
        "accepted_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "accepted_objections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target_claim_id", "target_evidence_ids", "target_action_id", "objection_kind", "cited_evidence_id"],
            "properties": {
              "target_claim_id": {"$ref": "#/$defs/id"},
              "target_evidence_ids": {"$ref": "#/$defs/evidence_set"},
              "target_action_id": {"$ref": "#/$defs/id"},
              "objection_kind": {"$ref": "#/$defs/objection_kind"},
              "cited_evidence_id": {"$ref": "#/$defs/id"}
            }
          }
        }
      }
    },
    "slide_ref": {
      "oneOf": [
        {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_:.-]*$"},
        {"type": "integer", "minimum": 0}
      ]
    },
    "round_slides": {
      "type": "object",
      "required": ["deliberation", "defense", "objection", "resolution"],
      "properties": {
        "reveal": {"$ref": "#/$defs/slide_ref"},
        "deliberation": {"$ref": "#/$defs/slide_ref"},
        "defense": {"$ref": "#/$defs/slide_ref"},
        "objection": {"$ref": "#/$defs/slide_ref"},
        "confrontation": {"$ref": "#/$defs/slide_ref"},
        "resolution": {"$ref": "#/$defs/slide_ref"}
      },
      "additionalProperties": false
    },
    "projection_map": {
      "type": "object",
      "required": ["schema_version", "game_id", "rounds"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "game_id": {"const": "tribunal-digital"},
        "tutorial": {"$ref": "#/$defs/slide_ref"},
        "closing": {"$ref": "#/$defs/slide_ref"},
        "rounds": {
          "type": "object",
          "required": ["R1", "R2", "R3", "R4", "FINAL"],
          "additionalProperties": false,
          "properties": {
            "R1": {"$ref": "#/$defs/round_slides", "required": ["reveal"]},
            "R2": {"$ref": "#/$defs/round_slides", "required": ["reveal"]},
            "R3": {"$ref": "#/$defs/round_slides", "required": ["reveal"]},
            "R4": {"$ref": "#/$defs/round_slides", "required": ["reveal"]},
            "FINAL": {"$ref": "#/$defs/round_slides", "not": {"required": ["reveal"]}}
          }
        }
      }
    }
  }
}
